<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bw_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvHeader"
            style="@style/ZenHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GIF to Spritesheet"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvBody"
            style="@style/ZenBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pick a GIF and choose how many frames to sample. Next you'll get a chance to rename every extracted frame before packing."
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnPickGif"
            style="@style/ZenButtonOutline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pick GIF" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="No GIF selected"
            android:textColor="@color/bw_grey"
            android:fontFamily="monospace" />

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@drawable/bw_hairline" android:layout_marginTop="20dp" android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/etFrameCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Number of frames to extract"
            android:text="24"
            android:inputType="number" />

        <EditText
            android:id="@+id/etFrameName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Animation name (used for frame naming)"
            android:text="anim" />

        <EditText
            android:id="@+id/etOutputName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Output file name (no extension)"
            android:text="spritesheet" />

        <Button
            android:id="@+id/btnConvert"
            style="@style/ZenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Rename Frames →" />

    </LinearLayout>
</ScrollView>
