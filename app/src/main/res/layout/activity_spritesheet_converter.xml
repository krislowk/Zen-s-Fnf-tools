<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bw_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="40dp">

        <TextView
            android:id="@+id/tvHeader"
            style="@style/ZenHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Spritesheet Converter" />

        <TextView
            android:id="@+id/tvBody"
            style="@style/ZenBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Pick the individual frame PNGs, in order. Next you'll get a chance to rename every frame before it's packed into one atlas." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bw_card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/ZenSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Frames" />

            <Button
                android:id="@+id/btnPickImages"
                style="@style/ZenButtonOutline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pick Frame Images" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:text="0 images selected"
                android:textColor="@color/bw_grey"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bw_card_bg"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/ZenSectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Names" />

            <EditText
                android:id="@+id/etFrameName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Animation name (used for frame naming)"
                android:singleLine="true"
                android:text="anim" />

            <EditText
                android:id="@+id/etOutputName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Output file name (no extension)"
                android:singleLine="true"
                android:text="spritesheet" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConvert"
            style="@style/ZenButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Rename Frames →" />

    </LinearLayout>
</ScrollView>
