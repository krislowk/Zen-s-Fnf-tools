<resources>
    <style name="Theme.ZenFNFToolkit" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/bw_white</item>
        <item name="colorOnPrimary">@color/bw_black</item>
        <item name="colorSecondary">@color/bw_white</item>
        <item name="colorOnSecondary">@color/bw_black</item>
        <item name="colorSurface">@color/bw_black</item>
        <item name="colorOnSurface">@color/bw_white</item>
        <item name="android:colorBackground">@color/bw_black</item>
        <item name="android:textColorPrimary">@color/bw_white</item>
        <item name="android:textColorSecondary">@color/bw_grey</item>
        <item name="android:windowBackground">@color/bw_black</item>
        <item name="android:statusBarColor">@color/bw_black</item>
        <item name="android:navigationBarColor">@color/bw_black</item>
        <item name="android:windowAnimationStyle">@style/ZenWindowAnimation</item>
        <item name="colorControlHighlight">@color/bw_grey_dim</item>
        <item name="colorControlNormal">@color/bw_white</item>
        <item name="colorControlActivated">@color/bw_white</item>
        <item name="editTextStyle">@style/ZenEditText</item>
    </style>

    <style name="ZenWindowAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/zen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/zen_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/zen_enter_back</item>
        <item name="android:activityCloseExitAnimation">@anim/zen_exit_back</item>
    </style>

    <style name="ZenEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/bw_white</item>
        <item name="android:textColorHint">@color/bw_grey_dim</item>
        <item name="android:background">@drawable/bw_edittext_underline</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="ZenButton">
        <item name="android:background">@drawable/bw_button_bg</item>
        <item name="android:textColor">@color/bw_black</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="ZenButtonOutline">
        <item name="android:background">@drawable/bw_button_outline_bg</item>
        <item name="android:textColor">@color/bw_white</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="ZenHeader">
        <item name="android:textColor">@color/bw_white</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="ZenBody">
        <item name="android:textColor">@color/bw_grey</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
</resources>
